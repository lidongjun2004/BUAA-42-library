{
  "Id": 1228,
  "Name": "P3_L12_lsh_2023",
  "Description": "# Load Selected Halfword\n\n\n\n<table style=\"border-collapse:collapse; width: 500pt;\">\n    <tr>\n        <td id=\"td-head\" rowspan=\"3\">\n            编码\n        </td>\n        <td id=\"td-opcode-top\">\n            <span style=\"float: left;\">31</span>\n            <span style=\"float: right;\">26</span>\n        </td>\n        <td id=\"td-rs-top\">\n            <span style=\"float: left;\">25</span>\n            <span style=\"float: right;\">21</span>\n        </td>\n        <td id=\"td-rt-top\">\n            <span style=\"float: left;\">20</span>\n            <span style=\"float: right;\">16</span>\n        </td>\n        <td id=\"td-imm-top\">\n            <span style=\"float: left;\">15</span>\n            <span style=\"float: right;\">0</span>\n        </td>\n    </tr>\n    <tr>\n        <td id=\"td-opcode\">\n            lsh<br />\n            101101\n        </td>\n        <td id=\"td-rs\">base</td>\n        <td id=\"td-rt\">\n            rt\n        </td>\n        <td id=\"td-imm\">\n            offset\n        </td>\n    </tr>\n    <tr>\n        <td id=\"td-opcode-bottom\">\n            6\n        </td>\n        <td id=\"td-rs-bottom\">\n            5\n        </td>\n        <td id=\"td-rt-bottom\">\n            5\n        </td>\n        <td id=\"td-imm-bottom\">\n            16\n        </td>\n    </tr>\n    <tr>\n        <td id=\"td-head\">\n            格式\n        </td>\n        <td colspan=\"4\">\n            <p id=\"p-code\">\n                lsh rt, offset(base)\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td id=\"td-head\">\n            描述\n        </td>\n        <td colspan=\"4\">\n            <p id=\"p-code\">\n                将 vAddr 的计算改成 GPR[base] xor zero_ext(offset)，其中 xor 指按位异或。将 vAddr 的第 1 位作为半字选择位，第 0 位作为结果符号拓展和零拓展的选择位\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td id=\"td-head\">\n            操作\n        </td>\n        <td colspan=\"4\">\n            <p id=\"p-code\">\n                vAddr ← GPR[base] xor zero_ext(offset)\n            </p>\n            <p id=\"p-code\">\n                memWord ← Memory[vAddr & 0xfffffffc]\n            </p>\n            <p id=\"p-code\">\n                byte ← vAddr<sub>1<sub>\n            </p>\n            <p id=\"p-code\">\n                sel ← vAddr<sub>0<sub>\n            </p>\n            <p id=\"p-code\">\n                if sel = 1'b0:\n            </p>\n            <p id=\"p-code\" style=\"text-indent: 4em\">\n                GPR[rt] ← zero_ext(memWord<sub>15 + 16*byte..16*byte</sub>)\n            </p>\n            <p id=\"p-code\">\n                else:\n            </p>\n            <p id=\"p-code\" style=\"text-indent: 4em\">\n                GPR[rt] ← sign_ext(memWord<sub>15 + 16*byte..16*byte</sub>)\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td id=\"td-head\">\n            示例\n        </td>\n        <td colspan=\"4\">\n            <p id=\"p-code\">\n                lsh $t1, 100($t2)\n            </p>\n        </td>\n    </tr>\n    <tr>\n        <td id=\"td-head\">\n            其他\n        </td>\n        <td colspan=\"4\">\n            <p id=\"p-text\">\n                从指令操作可知，本指令中 vAddr 无需对齐\n            </p>\n        </td>\n    </tr>\n</table>\n\n",
  "Type": 0,
  "LastSubmissionId": null,
