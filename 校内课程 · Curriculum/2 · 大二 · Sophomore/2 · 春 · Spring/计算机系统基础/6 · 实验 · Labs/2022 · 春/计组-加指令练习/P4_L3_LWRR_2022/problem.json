{
  "Id": 984,
  "Name": "P4_L3_LWRR_2022",
  "Description": "<table style=\"border-collapse:collapse; width: 500pt;\">\n    <tr>\n      <td id=\"td-head\" rowspan=\"3\">\n                编码\n            </td>\n      <td id=\"td-opcode-top\">\n        <span style=\"float: left;\">31</span>\n        <span style=\"float: right;\">26</span>\n      </td>\n      <td id=\"td-rs-top\">\n        <span style=\"float: left;\">25</span>\n        <span style=\"float: right;\">21</span>\n      </td>\n      <td id=\"td-rt-top\">\n        <span style=\"float: left;\">20</span>\n        <span style=\"float: right;\">16</span>\n      </td>\n      <td id=\"td-imm-top\">\n        <span style=\"float: left;\">15</span>\n        <span style=\"float: right;\">0</span>\n      </td>\n    </tr>\n    <tr>\n      <td id=\"td-opcode\">\n                LWRR<br/>\n                110100\n            </td>\n      <td id=\"td-rs\">base</td>\n      <td id=\"td-rt\">\n                rt\n            </td>\n      <td id=\"td-imm\">\n                offset\n            </td>\n    </tr>\n    <tr>\n      <td id=\"td-opcode-bottom\">\n                6\n            </td>\n      <td id=\"td-rs-bottom\">\n                5\n            </td>\n      <td id=\"td-rt-bottom\">\n                5\n            </td>\n      <td id=\"td-imm-bottom\">\n                16\n            </td>\n    </tr>\n    <tr>\n      <td id=\"td-head\">\n                格式\n            </td>\n      <td colspan=\"4\">\n        <p id=\"p-code\">\n                    lwrr rt, offset(base)\n                </p>\n      </td>\n    </tr>\n    <tr>\n      <td id=\"td-head\">\n                描述\n            </td>\n      <td colspan=\"4\">\n        <p id=\"p-code\">\n                    将从Memory[GPR[base] + sign_extend(offset)]取出的字循环右移vAddr<sub style=\"font-size: 65%\">1..0</sub>个字节后插入到GPR[rt]。\n                </p>\n      </td>\n    </tr>\n    <tr>\n      <td id=\"td-head\">\n                操作\n            </td>\n      <td colspan=\"4\">\n        <p id=\"p-code\">\n                    vAddr ← GPR[base] + sign_extend(offset)\n                </p>\n                 <p id=\"p-code\">pAddr ← vAddr<sub>31...2</sub> || 0<sup>2</sup></p>\n        <p id=\"p-code\">\n                    memword ← Memory[pAddr]\n                </p>\n        <p id=\"p-code\">\n          byte ← vAddr<sub style=\"font-size: 65%\">1..0</sub>\n                </p>\n        <p id=\"p-code\">\n                    if byte = 0 then\n                </p>\n        <p id=\"p-code\" style=\"text-indent: 2em\">\n                    GPR[rt] ← memword\n                </p>\n        <p id=\"p-code\">\n                    else\n                </p>\n        <p id=\"p-code\" style=\"text-indent: 2em\">\n                    GPR[rt] ← memword <sub style=\"font-size: 65%\">8*byte-1..0</sub> || memword <sub style=\"font-size: 65%\">31..8*byte</sub>\n                </p>\n        <p id=\"p-code\">\n                    endif\n                </p>\n      </td>\n    </tr>\n    <tr>\n      <td id=\"td-head\">\n                示例\n            </td>\n      <td colspan=\"4\">\n        <p id=\"p-code\">\n                    lwrr $s0, 3($0)\n                </p>\n      </td>\n    </tr>\n    <tr>\n      <td id=\"td-head\">\n                其他\n            </td>\n      <td colspan=\"4\">\n        <p id=\"p-text\">\n          地址不对齐时强制对齐，指令表现以.class指令扩展在MARS中的行为为准\n        </p>\n      </td>\n    </tr>\n  </table>",
