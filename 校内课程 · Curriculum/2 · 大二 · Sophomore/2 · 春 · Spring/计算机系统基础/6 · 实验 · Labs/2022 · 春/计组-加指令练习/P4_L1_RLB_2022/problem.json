  "Name": "P4_L1_RLB_2022",
  "Description": "<table style=\"border-collapse:collapse; width: 500pt;\">\n      <tr>\n        <td id=\"td-head\" rowspan=\"3\">\n                编码\n            </td>\n        <td id=\"td-opcode-top\">\n          <span style=\"float: left;\">31</span>\n          <span style=\"float: right;\">26</span>\n        </td>\n        <td id=\"td-rs-top\">\n          <span style=\"float: left;\">25</span>\n          <span style=\"float: right;\">21</span>\n        </td>\n        <td id=\"td-rt-top\">\n          <span style=\"float: left;\">20</span>\n          <span style=\"float: right;\">16</span>\n        </td>\n        <td id=\"td-imm-top\">\n          <span style=\"float: left;\">15</span>\n          <span style=\"float: right;\">0</span>\n        </td>\n      </tr>\n      <tr>\n        <td id=\"td-opcode\">\n                RLB<br/>\n                111111\n            </td>\n        <td id=\"td-rs\">rs</td>\n        <td id=\"td-rt\">rt</td>\n        <td id=\"td-imm\">\n                immediate\n            </td>\n      </tr>\n      <tr>\n        <td id=\"td-opcode-bottom\">\n                6\n            </td>\n        <td id=\"td-rs-bottom\">\n                5\n            </td>\n        <td id=\"td-rt-bottom\">\n                5\n            </td>\n        <td id=\"td-imm-bottom\">\n                16\n            </td>\n      </tr>\n      <tr>\n        <td id=\"td-head\">\n                格式\n            </td>\n        <td colspan=\"4\">\n          <p id=\"p-code\">\n                    rlb rt, rs, immediate\n                </p>\n        </td>\n      </tr>\n      <tr>\n        <td id=\"td-head\">\n                描述\n            </td>\n        <td colspan=\"4\">\n          <p id=\"p-text\">\n                    将GPR[rs]低immediate位按位取反后，存入GPR[rt]\n                </p>\n        </td>\n      </tr>\n      <tr>\n        <td id=\"td-head\">\n                操作\n            </td>\n        <td colspan=\"4\">\n          <p id=\"p-code\">def :</p>\n          <p id=\"p-code\" style=\"text-indent: 1em\">bitwise_not(x): 将x按位取反</p>\n          <p id=\"p-code\">if imm = 0 :</p>\n          <p id=\"p-code\" style=\"text-indent: 1em\">GPR[rt] ← GPR[rs]</p>\n          <p id=\"p-code\">else :</p>\n          <p id=\"p-code\" style=\"text-indent: 1em\">GPR[rt] ← GPR[rs]<sub>31...imm</sub>||bitwise_not(GPR[rs]<sub>imm-1...0</sub>)</p>\n        </td>\n      </tr>\n      <tr>\n        <td id=\"td-head\">\n                示例\n            </td>\n        <td colspan=\"4\">\n          <p id=\"p-code\">\n                    rlb $t0, $t1, 16\n                </p>\n        </td>\n      </tr>\n      <tr>\n        <td id=\"td-head\">\n                其他\n            </td>\n        <td colspan=\"4\">\n          <p id=\"p-text\">\n                  数据保证immediate在[0,31]闭区间内 \n                </p>\n        </td>\n      </tr>\n    </table>\n\n",
